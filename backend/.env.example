# ================================
# MongoDB
# ================================
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# ================================
# Server
# ================================
PORT=4000

# ================================
# JWT
# ================================
JWT_SECRET=your_jwt_secret_key_here

# ================================
# Admin credentials
# ================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password

# ================================
# Stripe (thanh toán online)
# ================================
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ================================
# Cloudinary (upload ảnh - legacy, hiện dùng R2)
# ================================
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET_KEY=your_cloudinary_api_secret

# ================================
# Cloudflare R2 (lưu trữ ảnh)
# ================================
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=your_r2_access_key_id
R2_SECRET_KEY=your_r2_secret_access_key
R2_BUCKET=your_bucket_name
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
