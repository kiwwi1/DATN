# ================================
# MongoDB
# ================================
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# ================================
# Server
# ================================
PORT=4000

# ================================
# Redis (auth/security)
# ================================
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=datn
AUTH_RL_WINDOW_SEC=900
AUTH_RL_MAX_LOGIN_IP=20
AUTH_RL_MAX_LOGIN_EMAIL=10
AUTH_RL_MAX_VERIFY_IP=30
AUTH_RL_MAX_VERIFY_EMAIL=10
AUTH_RL_MAX_FORGOT_IP=15
AUTH_RL_MAX_FORGOT_EMAIL=5
AUTH_RL_MAX_RESET_IP=20
AUTH_RL_MAX_REFRESH_IP=120

# ================================
# JWT
# ================================
JWT_SECRET=your_jwt_secret_key_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_ACCESS_COOKIE_MAX_AGE_MS=900000
JWT_REFRESH_COOKIE_MAX_AGE_MS=604800000
# Cookie auth options
# - Local same-origin dev: COOKIE_SAME_SITE=lax, COOKIE_SECURE=false
# - Tunnel/cross-site (localhost -> https api domain): COOKIE_SAME_SITE=none, COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# ================================
# Stripe (thanh toán online)
# ================================
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 1 hoặc nhiều webhook secret, ngăn cách bằng dấu phẩy (hữu ích khi rotate secret hoặc có nhiều endpoint test/prod)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ================================
# Order stock reservation
# ================================
# TTL giữ hàng cho đơn chờ thanh toán (phút)
PAYMENT_RESERVATION_TTL_MIN=15
# Chu kỳ quét đơn hết hạn giữ hàng (ms)
RESERVATION_SWEEP_INTERVAL_MS=60000

# ================================
# Cloudinary (upload ảnh - legacy, hiện dùng R2)
# ================================
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET_KEY=your_cloudinary_api_secret

# ================================
# Cloudflare R2 (lưu trữ ảnh)
# ================================
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=your_r2_access_key_id
R2_SECRET_KEY=your_r2_secret_access_key
R2_BUCKET=your_bucket_name
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
# Optional: image processing defaults
IMAGE_MIN_SHORT_SIDE=500
IMAGE_MAIN_MAX_EDGE=1400
IMAGE_THUMB_EDGE=480
IMAGE_MAIN_QUALITY=82
IMAGE_THUMB_QUALITY=76

# ================================
# AI (generate product description)
# ================================
GEMINI_API_KEY=your_gemini_api_key
# Optional
GEMINI_MODEL=gemini-1.5-flash

# ================================
# Gmail (quên mật khẩu — App Password, bật 2FA)
# ================================
MAIL_USER=your@gmail.com
MAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Tuỳ chọn: hiển thị người gửi (mặc định = MAIL_USER)
# MAIL_FROM=your@gmail.com
# URL frontend để gắn link đặt lại mật khẩu + redirect VNPay (không có dấu / cuối)
FRONTEND_URL=http://localhost:5173

# ================================
# VNPay (thanh toán nội địa)
# ================================
VNP_TMN_CODE=your_tmn_code
VNP_HASH_SECRET=your_hash_secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Endpoint backend nhận callback từ VNPay (phải là HTTPS trên production)
VNP_RETURN_URL=http://localhost:4000/api/order/vnpay-return

# ================================
# Price-drop notifications
# ================================
PRICE_DROP_DEDUP_HOURS=24
# Thời gian cho phép trả hàng sau khi nhận (ngày)
RETURN_WINDOW_DAYS=7
# Bật/tắt gửi email khi giá giảm (mặc định true — đặt false để tắt)
PRICE_DROP_EMAIL_ENABLED=true
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
