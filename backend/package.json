    "resync-external-images": "node scripts/resyncDummyJsonImages.js && node scripts/resyncFakestoreImages.js",
    "fix-broken-seed-images": "node scripts/fixBrokenSeedImages.js",
    "fix-primary-product-image": "node scripts/fixPrimaryProductImage.js",
    "generate-unique-products": "node scripts/generateUniqueProducts.js",
    "generate-marketplace-products": "node scripts/generateMarketplaceProducts.js",
