@startuml
top to bottom direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam ArrowColor #3A78C2
skinparam PackageBorderColor #3A78C2

title Bieu do goi phia may chu (Backend)

package "backend" {
  package "routes" as routes
  package "middleware" as middleware
  package "controllers" as controllers
  package "services" as services
  package "models" as models
  package "config" as config
  package "utils" as utils
}

database "MongoDB" as mongo
rectangle "Redis" as redis
cloud "Stripe / VNPay / R2" as external

routes --> middleware : filter/authorize
routes --> controllers : dispatch
controllers --> services : delegate
controllers --> utils : format
services --> models : query
services --> config : read settings
middleware --> config : authenticate
models --> mongo : read/write
config --> redis : connect
services --> external : invoke

@enduml
