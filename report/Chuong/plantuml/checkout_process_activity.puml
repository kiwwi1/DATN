@startuml
skinparam shadowing false
skinparam activity {
  BackgroundColor #F3F4F6
  BorderColor #3B82F6
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #3B82F6
  FontColor #1F2937
  FontSize 12
}

skinparam swimlane {
  BorderColor #D1D5DB
  BorderThickness 1.5
  TitleBackgroundColor #EFF6FF
  TitleFontColor #1E40AF
  TitleFontName sans-serif
  TitleFontSize 13
  TitleFontStyle bold
}

title Biểu đồ hoạt động quy trình Đặt hàng - Giữ kho - Thanh toán

|Khách hàng|
start

:Khách hàng bắt đầu checkout;

|Hệ thống Backend|
:Gọi API xem trước hóa đơn,\ntải sản phẩm, voucher và tính bảng giá;

|Khách hàng|
:Hiển thị kết quả xem trước,\nchọn PTTT và xác nhận đặt hàng;

|Hệ thống Backend|
:Kiểm tra chống trùng đơn\nvà thực hiện Giữ kho nguyên tử;

if (Đủ hàng trong kho?) then (Có)
  :Tạo đơn với thông tin\nthời điểm và thời hạn giữ kho;

  if (Phương thức thanh toán?) then (COD)
    :Tạo đơn ở trạng thái Đã đặt hàng,\ncập nhật số lượng bán, xóa giỏ hàng\nvà gửi thông báo cho nhà bán;
    stop
  else (Stripe hoặc VNPay)
    :Giữ cờ chờ thanh toán và tạo\nphiên Stripe hoặc đường dẫn VNPay;
    
    |Khách hàng|
    :Điều hướng khách hàng\nđến cổng thanh toán;

    |Cổng thanh toán|
    if (Thanh toán thành công?) then (Có)
      |Hệ thống Backend|
      :Nhận Stripe webhook hoặc VNPay callback,\ncập nhật đơn thành công, cập nhật số bán,\nxóa giỏ hàng và báo nhà bán;
      stop
    else (Không hoặc quá hạn)
      |Tác vụ nền|
      :Phát hiện đơn quá hạn, chuyển đơn sang Đã hủy\nvà hoàn trả tồn kho hoặc lượt sử dụng voucher;
      stop
    endif
  endif
else (Không)
  |Hệ thống Backend|
  :Trả lỗi không đủ tồn kho cho khách hàng;
  stop
endif

@enduml
