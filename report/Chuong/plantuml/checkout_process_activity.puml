@startuml
skinparam shadowing false
skinparam activity {
  BackgroundColor white
  BorderColor #4A90E2
  DiamondBackgroundColor white
}

title Biểu đồ hoạt động quy trình Đặt hàng - Giữ kho - Thanh toán

start

:Khách hàng bắt đầu checkout;
:Gọi API xem trước hóa đơn;
:Backend tải sản phẩm, voucher\nvà tính bảng giá nhiều lớp;
:Hiển thị kết quả xem trước cho người dùng;
:Khách hàng chọn phương thức thanh toán\nvà xác nhận đặt hàng;
:Kiểm tra mã chống trùng đơn;
:Giữ kho nguyên tử;

if (Đủ hàng trong kho?) then (Có)
  :Tạo đơn với thông tin\nthời điểm và thời hạn giữ kho;

  if (Phương thức thanh toán?) then (COD)
    :Tạo đơn ở trạng thái Đã đặt hàng;
    :Cập nhật số lượng bán,\nxóa giỏ hàng,\ngửi thông báo cho nhà bán;
    stop
  else (Stripe/VNPay)
    :Giữ cờ chờ thanh toán;
    :Tạo phiên Stripe hoặc đường dẫn VNPay;
    :Điều hướng khách hàng đến\ncổng thanh toán;

    if (Thanh toán thành công?) then (Có)
      :Nhận Stripe webhook hoặc\nVNPay callback hợp lệ;
      :Cập nhật trạng thái\nthanh toán thành công;
      :Cập nhật số lượng bán,\nxóa giỏ hàng,\ngửi thông báo cho nhà bán;
      stop
    else (Không / quá hạn)
      :Tác vụ nền phát hiện đơn quá hạn;
      :Chuyển trạng thái đơn sang Đã hủy;
      :Hoàn trả tồn kho và\nhoàn lượt sử dụng voucher;
      stop
    endif
  endif
else (Không)
  :Trả lỗi không đủ tồn kho;
  stop
endif

@enduml
