@startuml
hide footbox
skinparam shadowing false
skinparam ParticipantPadding 10
skinparam BoxPadding 5
skinparam maxMessageSize 50
skinparam sequence {
  ArrowColor #3A78C2
  LifeLineBorderColor #7AA7E0
  LifeLineBackgroundColor #F8FBFF
  ParticipantBorderColor #3A78C2
  ParticipantBackgroundColor white
}

title Biểu đồ tuần tự thanh toán trực tuyến và xác nhận kết quả

actor "Khách hàng" as Buyer
participant "Client (React)" as Client
participant "Backend (Node.js)" as BE
database "Database\n(MongoDB/Redis)" as DB
participant "Cổng thanh toán" as PG

== Stripe ==
Client -> BE: Khởi tạo thanh toán Stripe
BE -> PG: Tạo phiên Stripe Checkout
PG --> BE: Trả về link thanh toán
BE -> DB: Lưu thông tin phiên Stripe
BE --> Client: Phản hồi link thanh toán
Client -> PG: Chuyển hướng sang Stripe
Buyer -> PG: Xác nhận thanh toán
PG --> Client: Redirect về Frontend (Success)
PG --> BE: Gửi Stripe Webhook (Success)
BE -> DB: Cập nhật đơn hàng & giỏ hàng
BE --> PG: Phản hồi HTTP 200
Client --> Buyer: Hiển thị thành công

== VNPay ==
Client -> BE: Khởi tạo thanh toán VNPay
BE -> PG: Tạo link thanh toán VNPay
PG --> BE: Trả về link thanh toán
BE -> DB: Lưu thông tin link VNPay
BE --> Client: Phản hồi link thanh toán
Client -> PG: Chuyển hướng sang VNPay
Buyer -> PG: Xác nhận thanh toán
PG --> Client: Redirect về Backend Callback
Client -> BE: GET callback (query params)
BE -> DB: Xác minh chữ ký & Cập nhật đơn/giỏ hàng
BE --> Client: Redirect (302) về Frontend (Success)
Client --> Buyer: Hiển thị thành công

@enduml



