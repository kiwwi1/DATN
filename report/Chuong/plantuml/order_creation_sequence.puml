@startuml
hide footbox
skinparam shadowing false
skinparam ParticipantPadding 12
skinparam BoxPadding 8
skinparam maxMessageSize 28
skinparam sequence {
  ArrowColor #3A78C2
  LifeLineBorderColor #7AA7E0
  LifeLineBackgroundColor #F8FBFF
  ParticipantBorderColor #3A78C2
  ParticipantBackgroundColor white
}

title Biểu đồ tuần tự\nTạo đơn hàng và giữ kho nguyên tử

actor "Khách hàng" as Buyer
participant "Client\n(React)" as Client
participant "Backend\n(Node.js)" as BE
database "Database\n(MongoDB/Redis)" as DB

== Tạo đơn và\ngiữ kho ==
Buyer -> Client: Xác nhận đặt hàng\n(chọn PTTT)
Client -> BE: POST /api/orders\n(kèm PTTT & idempotency key)
BE -> DB: Kiểm tra trùng đơn\n& giữ kho nguyên tử
alt Hết hàng
  DB --> BE: Thao tác thất bại\n(thiếu hàng)
  BE --> Client: Trả lỗi hết hàng (HTTP 400)
  Client --> Buyer: Hiển thị sản phẩm\nkhông đủ kho
else Đủ hàng
  DB --> BE: Xác nhận giữ kho thành công
  BE -> DB: Tạo đơn, lưu voucher\n& cập nhật tồn kho/giỏ hàng
  BE --> Client: Trả về mã đơn hàng\n& link thanh toán (nếu có)
  Client --> Buyer: Hiển thị thành công\n/ Chuyển hướng thanh toán
end

@enduml


