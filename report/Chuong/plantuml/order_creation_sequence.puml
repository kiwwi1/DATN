@startuml
hide footbox
skinparam shadowing false
skinparam ParticipantPadding 12
skinparam BoxPadding 8
skinparam maxMessageSize 42
skinparam sequence {
  ArrowColor #3A78C2
  LifeLineBorderColor #7AA7E0
  LifeLineBackgroundColor #F8FBFF
  ParticipantBorderColor #3A78C2
  ParticipantBackgroundColor white
}

title Biểu đồ tuần tự tạo đơn hàng và giữ kho nguyên tử

actor "Khách hàng" as Buyer
participant "Client (React)" as Client
participant "Backend (Node.js)" as BE
database "Database\n(MongoDB/Redis)" as DB

== Xem trước hóa đơn ==
Buyer -> Client: Chọn sản phẩm, voucher\nvà bấm Checkout
Client -> BE: Yêu cầu xem trước hóa đơn
BE -> DB: Tải sản phẩm,\nbiến thể, voucher
DB --> BE: Dữ liệu định giá
BE -> BE: Tính giá và áp dụng\nvoucher nhiều lớp
BE --> Client: Bảng kê giá,\nvoucher hợp lệ / bị từ chối

== Tạo đơn và giữ kho ==
Buyer -> Client: Chọn phương thức thanh toán\nvà xác nhận đặt hàng

alt COD
  Client -> BE: Yêu cầu đặt hàng (COD)
  BE -> DB: Kiểm tra mã chống trùng đơn
  BE -> DB: Giữ kho nguyên tử
  alt Không đủ tồn kho
    DB --> BE: Thiếu hàng
    BE --> Client: Thông báo hết hàng
    Client --> Buyer: Hiển thị sản phẩm không đủ kho
  else Giữ kho thành công
    DB --> BE: Xác nhận đã giữ kho
    BE -> DB: Tạo đơn ở trạng thái\nĐã đặt hàng
    BE -> DB: Lưu voucher áp dụng,\nthời điểm và thời hạn giữ kho
    BE -> DB: Cập nhật số lượng bán,\nxóa sản phẩm khỏi giỏ hàng
    BE --> Client: Mã đơn hàng, thành công
    Client --> Buyer: Hiển thị đơn đã tạo
  end

else Stripe
  Client -> BE: Yêu cầu đặt hàng (Stripe)
  BE -> DB: Kiểm tra mã chống trùng đơn
  BE -> DB: Giữ kho nguyên tử
  alt Không đủ tồn kho
    DB --> BE: Thiếu hàng
    BE --> Client: Thông báo hết hàng
    Client --> Buyer: Hiển thị sản phẩm không đủ kho
  else Giữ kho thành công
    DB --> BE: Xác nhận đã giữ kho
    BE -> DB: Tạo đơn ở trạng thái Đã đặt hàng,\ncờ chờ thanh toán
    BE -> DB: Lưu voucher áp dụng,\nthời điểm và thời hạn giữ kho
    BE --> Client: Mã đơn hàng,\nchuẩn bị tạo phiên Stripe
  end

else VNPay
  Client -> BE: Yêu cầu đặt hàng (VNPay)
  BE -> DB: Kiểm tra mã chống trùng đơn
  BE -> DB: Giữ kho nguyên tử
  alt Không đủ tồn kho
    DB --> BE: Thiếu hàng
    BE --> Client: Thông báo hết hàng
    Client --> Buyer: Hiển thị sản phẩm không đủ kho
  else Giữ kho thành công
    DB --> BE: Xác nhận đã giữ kho
    BE -> DB: Tạo đơn ở trạng thái Đã đặt hàng,\ncờ chờ thanh toán
    BE -> DB: Lưu voucher áp dụng,\nthời điểm và thời hạn giữ kho
    BE --> Client: Mã đơn hàng,\nchuẩn bị tạo đường dẫn VNPay
  end
end

@enduml
