@startuml controllers_class
skinparam packageStyle rectangle
skinparam classBackgroundColor White
skinparam classBorderColor #444444
skinparam arrowColor #333333
skinparam packageBorderColor #444444
skinparam packageBackgroundColor #FAFAFA
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12

package "controllers" {
    class ProductController
    class OrderController
    class VoucherController
    class AuthController
    class UserController
    class ChatController
}

package "services" #EEEEEE {
    class ProductService
    class OrderService
    class VoucherService
    class AuthService
    class UserService
    class ChatService
}

ProductController ..> ProductService : <<use>>
OrderController   ..> OrderService   : <<use>>
VoucherController ..> VoucherService : <<use>>
AuthController    ..> AuthService    : <<use>>
UserController    ..> UserService    : <<use>>
ChatController    ..> ChatService    : <<use>>

@enduml
